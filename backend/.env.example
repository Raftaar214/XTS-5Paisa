# Copy this file to backend/.env and fill in your own values.
# backend/.env is never committed — it holds passwords and API keys.

# ── Dashboard users (APP_USER1_*, APP_USER2_*, … up to 20) ──
APP_USER1_NAME=trader1
APP_USER1_PASSWORD=change-this-password
# APP_USER2_NAME=trader2
# APP_USER2_PASSWORD=change-this-password

# Long random string; keeps users logged in across restarts.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret

# ── Admin console (Ctrl+Shift+Space). Use a different, strong password. ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Browser origins allowed to call the API (comma-separated).
# Unset = the server's own address, localhost and private-LAN addresses.
# CORS_ORIGINS=https://desk.example.com

# ── XTS 5paisa ──
XTS_INTERACTIVE_URL=https://xtsmum.5paisa.com
XTS_MARKET_URL=https://xtsmum.5paisa.com
XTS_SOURCE=WEBAPI
MARKET_SOURCE=WEBAPI

# First-run bootstrap only (used when data/clients.json does not exist yet).
# After that, manage clients in the Admin console.
MARKET_APP_KEY=your-market-data-app-key
MARKET_SECRET_KEY=your-market-data-secret-key
CLI1_ID=your-parent-client-id
CLI1_NAME=Parent Client
CLI1_INTERACTIVE_KEY=your-interactive-app-key
CLI1_INTERACTIVE_SECRET=your-interactive-secret-key

# ── Server ──
# Dashboard, API and live quotes (/ws) all use this one port.
PORT=5000
# true = log every enabled client in to the broker when the server starts
AUTO_LOGIN_ON_START=false

# Optional — this is the default
# INSTRUMENT_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz

# Optional tuning
# ORDER_MIN_GAP_MS=110
# ORDER_POLL_GAP_MS=100
# MARKET_RELOGIN_BASE_MS=2000
# MARKET_TAKEOVER_BACKOFF_MS=30000
# XTS_DATA_DIR=./data
